<%- include('layout', { user: user }) %>

<h2>Mecze</h2>

<h3>Dodaj mecz</h3>

<form method="post" action="/admin/matches/add">
  <input name="home_team" placeholder="Gospodarz">
  <input name="away_team" placeholder="Goście">
  <input name="start_time" placeholder="2025-01-01 20:00">
  <button>Dodaj</button>
</form>

<hr>

<table>
  <tr>
    <th>Mecz</th>
    <th>Start</th>
    <th>Wynik</th>
    <th>Ustaw wynik</th>
    <th>Usuń</th>
  </tr>

  <% matches.forEach(m => { %>
    <tr>
      <td><%= m.home_team %> - <%= m.away_team %></td>
      <td><%= m.start_time %></td>
      <td>
        <% if (m.home_score != null) { %>
          <%= m.home_score %> : <%= m.away_score %>
        <% } else { %>
          -
        <% } %>
      </td>
      <td>
        <form method="post" action="/admin/matches/<%= m.id %>/result">
          <input type="number" name="home_score" style="width:40px">
          :
          <input type="number" name="away_score" style="width:40px">
          <button>OK</button>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/matches/<%= m.id %>/delete">
          <button onclick="return confirm('Usunąć mecz?')">🗑️</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>

</body></html>
