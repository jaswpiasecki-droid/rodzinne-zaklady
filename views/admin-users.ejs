<%- include('layout', { user: user }) %>

<h2>Użytkownicy</h2>

<table>
  <tr>
    <th>ID</th>
    <th>Login</th>
    <th>Admin</th>
    <th>Typy</th>
    <th>Punkty</th>
    <th>Usuń</th>
  </tr>

  <% users.forEach(u => { %>
    <tr>
      <td><%= u.id %></td>
      <td><%= u.username %></td>
      <td><%= u.is_admin ? "✔️" : "❌" %></td>
      <td><%= u.bets_count %></td>
      <td><%= u.total_points %></td>
      <td>
        <% if (!u.is_admin) { %>
          <form method="post" action="/admin/users/<%= u.id %>/delete">
            <button onclick="return confirm('Na pewno usunąć?')">🗑️</button>
          </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>

</body></html>
