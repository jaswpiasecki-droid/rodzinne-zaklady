<%- include('layout', { user: user }) %>

<h2>Twoje typy</h2>

<table>
  <tr>
    <th>Mecz</th>
    <th>Start</th>
    <th>Twój typ</th>
    <th>Punkty</th>
  </tr>

  <% matches.forEach(m => { %>
    <tr>
      <td><%= m.home_team %> - <%= m.away_team %></td>
      <td><%= m.start_time %></td>

      <td>
        <% const matchStarted = new Date(m.start_time) <= new Date(); %>

        <% if (!matchStarted) { %>
          <!-- Formularz obstawiania PRZED meczem -->
          <form method="post" action="/bet/<%= m.id %>">
            <input type="number" name="home_score" value="<%= m.bet_home ?? '' %>" style="width:40px">
            :
            <input type="number" name="away_score" value="<%= m.bet_away ?? '' %>" style="width:40px">
            <button>Zapisz</button>
          </form>

        <% } else { %>
          <!-- Po rozpoczęciu meczu -->
          <% if (m.bet_home != null) { %>
            <%= m.bet_home %> : <%= m.bet_away %> (zablokowane)
          <% } else { %>
            brak typu (za późno)
          <% } %>
        <% } %>
      </td>

      <td>
        <% if (m.points != null) { %>
          <%= m.points %>
        <% } else { %>
          -
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>

</body></html>
